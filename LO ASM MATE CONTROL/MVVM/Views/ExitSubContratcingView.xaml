<UserControl x:Class="LO_ASM_MATE_CONTROL.MVVM.Views.ExitSubContratcingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LO_ASM_MATE_CONTROL.MVVM.Views"
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="920">
    <Grid Background="{StaticResource IndustrialWindowBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource IndustrialPanelBrush}"
                BorderBrush="{StaticResource IndustrialBorderBrush}"
                BorderThickness="1"
                Padding="14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Client / sous-traitant"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBox Name="SearchTextBox"
                         Grid.Column="1"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="34"/>
                <Button Grid.Column="2"
                        Content="Rechercher"
                        Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SearchCommand}"/>
                <TextBlock Grid.Column="3"
                           Text="Selection des bobines client avant export"
                           Foreground="{StaticResource IndustrialMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>
            </Grid>
        </Border>

        <DataGrid Name="ResultsDataGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding PackagingUnits}"/>

        <Border Grid.Row="2"
                Background="{StaticResource IndustrialPanelBrush}"
                BorderBrush="{StaticResource IndustrialBorderBrush}"
                BorderThickness="1"
                Padding="12"
                Margin="0,14,0,0">
            <DockPanel>
                <TextBlock Text="Export CSV puis remise a zero des quantites du client filtre."
                           Foreground="{StaticResource IndustrialMutedBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="Generer CSV"
                        DockPanel.Dock="Right"
                        MinWidth="132"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding GenerateCsvCommand}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
