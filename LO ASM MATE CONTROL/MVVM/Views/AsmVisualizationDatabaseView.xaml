<UserControl x:Class="LO_ASM_MATE_CONTROL.MVVM.Views.AsmVisualizationDatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LO_ASM_MATE_CONTROL.MVVM.Views"
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="920">
    <Grid Background="{StaticResource IndustrialWindowBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource IndustrialPanelBrush}"
                BorderBrush="{StaticResource IndustrialBorderBrush}"
                BorderThickness="1"
                Padding="14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Recherche"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchTextBox_KeyDown"
                         MinHeight="34"/>
                <TextBlock Grid.Column="2"
                           Text="Filtrage direct des packaging units"
                           Foreground="{StaticResource IndustrialMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
                <Image Grid.Column="3"
                       Source="../../Resources/Images/logo.jpg"
                       Width="112"
                       Stretch="Uniform"
                       Margin="18,0,0,0"/>
            </Grid>
        </Border>
        
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding PackagingUnits}"/>
    </Grid>
</UserControl>
