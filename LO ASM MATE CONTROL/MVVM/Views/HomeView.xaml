<UserControl x:Class="LO_ASM_MATE_CONTROL.MVVM.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LO_ASM_MATE_CONTROL.MVVM.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource IndustrialWindowBrush}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource IndustrialPanelBrush}"
                BorderBrush="{StaticResource IndustrialBorderBrush}"
                BorderThickness="1"
                Padding="18"
                Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <Image DockPanel.Dock="Right"
                       Source="../../Resources/Images/logo.jpg"
                       Width="150"
                       Stretch="Uniform"
                       Margin="20,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="Tableau de bord ASM MATE"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Operations stock, bobines et synchronisation ASMPT"
                               Foreground="{StaticResource IndustrialMutedBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <UniformGrid Grid.Row="1" Columns="2" Rows="2">
            <GroupBox Header="Flux bobines" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="Lecture, creation, mise a jour et suppression des packaging units."
                               Foreground="{StaticResource IndustrialMutedBrush}"
                               TextWrapping="Wrap"/>
                    <Separator Margin="0,12,0,12"/>
                    <TextBlock Text="Point de controle : scan bobine, quantites, magasin, client."
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Base ASMPT" Margin="10,0,0,10">
                <StackPanel>
                    <TextBlock Text="Consultation rapide des bobines connues par article ou client."
                               Foreground="{StaticResource IndustrialMutedBrush}"
                               TextWrapping="Wrap"/>
                    <Separator Margin="0,12,0,12"/>
                    <TextBlock Text="Vue tableau optimisee pour tri, lecture et verification terrain."
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Synchronisation stock" Margin="0,10,10,0">
                <StackPanel>
                    <TextBlock Text="Generation des fichiers magasins, GPAO et exports CSV."
                               Foreground="{StaticResource IndustrialMutedBrush}"
                               TextWrapping="Wrap"/>
                    <Separator Margin="0,12,0,12"/>
                    <TextBlock Text="Actions disponibles dans le panneau lateral."
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Sous-traitance" Margin="10,10,0,0">
                <StackPanel>
                    <TextBlock Text="Filtrage des bobines par client, export CSV et remise a zero."
                               Foreground="{StaticResource IndustrialMutedBrush}"
                               TextWrapping="Wrap"/>
                    <Separator Margin="0,12,0,12"/>
                    <TextBlock Text="Flux dedie aux sorties client."
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>
        </UniformGrid>
    </Grid>
</UserControl>
